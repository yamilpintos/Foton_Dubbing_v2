# Copiar a .env y completar. Nunca subir .env a un repo.

# Google OAuth (Aplicación web). URI de redirección: http://localhost:8790/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ElevenLabs. Si no está acá, se toma de dubai_v2/.env
ELEVENLABS_API_KEY=
# Segunda cuenta, opcional (aparece un selector en la web)
# ELEVENLABS_API_KEY_ALT=

# Opcionales
# DOBLAJE_PUERTO=8790
# DOBLAJE_URL=http://localhost:8790          (forzar la URL pública, p.ej. detrás de un túnel)
# DOBLAJE_TRABAJO=C:\ruta\a\carpeta\de\trabajo
# FFMPEG=C:\ruta\a\ffmpeg.exe

# Perillas (el valor de fábrica está en config.py)
# DOBLAJE_CR_POR_MIN=13245        créditos por minuto de fuente, para la estimación (medido, cuenta paga)
# DOBLAJE_CLONACION=1             cloning_strength por defecto (0-10). 7 es el de ElevenLabs y deja el original
# DOBLAJE_UMBRAL=0.28             parecido acústico a partir del cual un segmento cuenta como "quedó el original"
# DOBLAJE_MAX_SUBIDA_MB=200       más pesado que esto se comprime a 720p antes de subir (mismo cobro)
# DOBLAJE_SIMULTANEOS=2           trabajos a la vez (ElevenLabs admite 3 por cuenta)
# DOBLAJE_MAX_POR_DIA=30
